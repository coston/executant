FROM node:24-slim

# Install Claude CLI and OpenCode CLI globally so they are available on PATH
# inside the container for both Claude and OpenCode eval runs.
RUN npm install -g @anthropic-ai/claude-code opencode-ai

# git and bash are required by executant workflows (script steps, git commits).
RUN apt-get update && apt-get install -y git bash && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
